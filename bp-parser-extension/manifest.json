{
  "manifest_version": 3,
  "name": "BP Parser for SVTR",
  "version": "1.0.0",
  "description": "从Business Plan提取信息并自动填写SVTR飞书申请表单",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://svtrglobal.feishu.cn/*",
    "http://127.0.0.1:3727/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://svtrglobal.feishu.cn/share/base/form/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
